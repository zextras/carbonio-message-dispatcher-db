pkgname="carbonio-message-dispatcher-db"
pkgver="0.5.4"
pkgrel="SNAPSHOT"
pkgdesc="Carbonio Message Dispatcher DB sidecar"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('any')
license=("AGPL-3.0-only")
depends=(
  "carbonio-core"
  "jq"
  "pending-setups"
  "service-discover"
  "service-discover-base"
)
backup=(
  "etc/zextras/service-discover/carbonio-message-dispatcher-db.hcl"
)
source=(
  "111-carbonio-message-dispatcher-db-setup.sh"
  "carbonio-message-dispatcher-db"
  "carbonio-message-dispatcher-db.hcl"
  "carbonio-message-dispatcher-db-bootstrap"
  "carbonio-message-dispatcher-db-sidecar.service"
  "carbonio-message-dispatcher-db-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
