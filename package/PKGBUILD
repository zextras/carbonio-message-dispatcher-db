_package_common() {
  install -Dm644 "${srcdir}/111-carbonio-message-dispatcher-db-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/111-carbonio-message-dispatcher-db-setup.sh"
  install -Dm755 "${srcdir}/carbonio-message-dispatcher-db" \
    "${pkgdir}/usr/bin/carbonio-message-dispatcher-db"
  install -Dm644 "${srcdir}/carbonio-message-dispatcher-db.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-message-dispatcher-db.hcl"
  install -Dm755 "${srcdir}/carbonio-message-dispatcher-db-bootstrap" \
    "${pkgdir}/usr/bin/carbonio-message-dispatcher-db-bootstrap"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/message-dispatcher-db/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/message-dispatcher-db/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/message-dispatcher-db/service-discover/service-protocol.json"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-message-dispatcher-db-sidecar.service" \
    "${pkgdir}/lib/systemd/system/carbonio-message-dispatcher-db-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-message-dispatcher-db-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/carbonio-message-dispatcher-db-sidecar.service"
}

package() { _package_systemd; }
package__rocky_8() { _package_legacy; }
package__ubuntu_jammy() { _package_legacy; }

postinst() {
  getent group 'carbonio-message-dispatcher-db' >/dev/null ||
    groupadd -r 'carbonio-message-dispatcher-db'
  getent passwd 'carbonio-message-dispatcher-db' >/dev/null ||
    useradd -r -M -g 'carbonio-message-dispatcher-db' -s /sbin/nologin 'carbonio-message-dispatcher-db'

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-message-dispatcher-db-sidecar.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Message Dispatcher DB installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-message-dispatcher-db-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-message-dispatcher-db-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/carbonio/message-dispatcher-db/service-discover/token
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
